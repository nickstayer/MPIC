<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>mpic-email-crm-integration-2026</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MegaplanSync\MegaplanSync.ApiClient\MegaplanSync.ApiClient.csproj" />
    <ProjectReference Include="..\MegaplanSync\MegaplanSync.Core\MegaplanSync.Core.csproj" />
    <ProjectReference Include="..\MegaplanSync\MegaplanSync.Logging\MegaplanSync.Logging.csproj" />
    <ProjectReference Include="..\MegaplanSync\MegaplanSync.Service\MegaplanSync.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

  <!-- appsettings.json — копируется в выходную директорию -->
  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Файлы Megaplan (токены, маппинги, контакты) — копируются в выходную директорию -->
  <ItemGroup>
    <Content Include="Megaplan\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>